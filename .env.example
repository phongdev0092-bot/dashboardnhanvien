# Cấu hình Google Sheets
GOOGLE_SHEET_ID=17QLc9SlfpPPrR-d1R2BkBxA7DmCI5ZCuhmQffP5F6pY
GOOGLE_SHEET_GID=32204814

# Thời gian lưu cache dữ liệu (giây) - Mặc định 5 phút = 300s
CACHE_TTL_SECONDS=300

# Bảo mật dữ liệu nhạy cảm (Password, CMND)
# true: cho phép xem Password/CMND khi bấm icon con mắt trong dialog chi tiết
# false: ẩn hoàn toàn Password, chỉ hiện 3 số cuối CMND
SHOW_SENSITIVE=false

# Mật khẩu bảo vệ truy cập Dashboard (để trống nếu không muốn yêu cầu đăng nhập)
# Ví dụ: DASHBOARD_PASSWORD=admin123
DASHBOARD_PASSWORD=

# Khóa bí mật cho session cookie (đổi thành chuỗi ngẫu nhiên khi đưa lên production)
SESSION_SECRET=secret-token-key-2026-dashboard

# Cấu hình Server
HOST=127.0.0.1
PORT=8000
